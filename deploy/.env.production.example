# Production settings for docker-compose.prod.yml. Copy to .env.production at
# the repository root, fill in, and keep it off git (it is ignored).
#
# Compose reads this file to fill in docker-compose.prod.yml; it is not handed
# to any container as a whole. Each service gets only the values it needs, so
# the app never sees the MongoDB root password. A variable added here reaches
# the app only once it is also listed under `app.environment` there.
#
# Generate secrets with:
#   MONGO_ROOT_PASSWORD, MONGO_APP_PASSWORD, REDIS_PASSWORD:  openssl rand -hex 32
#     (hex: they go inside connection URLs, where + / = would need escaping)
#   AUTH_SECRET, CRON_SECRET:                                 openssl rand -base64 48

APP_DOMAIN=bricks.example.com
# Leave empty for a Let's Encrypt certificate (DNS must point here and ports
# 80/443 be reachable). `tls internal` for a LAN-only address such as an IP.
APP_TLS=
NEXT_PUBLIC_APP_NAME=Fly Ash Bricks

AUTH_SECRET=
CRON_SECRET=

MONGODB_DB_NAME=flyash
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=flyash_app
MONGO_APP_PASSWORD=
REDIS_PASSWORD=

MAIL_TRANSPORT=smtp
MAIL_FROM=alerts@example.com
SMTP_URL=smtps://user:password@smtp.example.com:465

LOG_LEVEL=info

# Proxies in front of the app that append to X-Forwarded-For. 1 = Caddy only.
# Behind Cloudflare or a load balancer see docs/security.md before changing it.
TRUSTED_PROXY_HOPS=1

# Nightly encrypted backups (see docs/backup.md). Written to the `backups`
# volume; keep the passphrase (at least 16 characters) in a password manager —
# without it the files cannot be opened.
BACKUP_PASSPHRASE=
BACKUP_RETENTION_DAYS=30
# Comma-separated; leave blank to keep backups on the server only.
BACKUP_EMAIL_TO=

# Text messages and WhatsApp (see docs/notifications.md); `none` turns a channel off.
SMS_PROVIDER=none
SMS_WEBHOOK_URL=
SMS_WEBHOOK_SECRET=
WHATSAPP_PROVIDER=none
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_SECRET=
