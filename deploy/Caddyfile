# Security headers are set by the app itself (HSTS, frame and referrer policy
# in next.config.ts, the CSP in proxy.ts), so they hold however it is served;
# not repeated here.
#
# Behind Cloudflare or a load balancer, add a global block so Caddy takes the
# client address from it instead of the proxy's (see docs/security.md):
#   {
#   	servers {
#   		trusted_proxies static <the proxy's address ranges>
#   		client_ip_headers CF-Connecting-IP X-Forwarded-For
#   	}
#   }

{$APP_DOMAIN} {
	# Empty by default: a public certificate from Let's Encrypt. Set to
	# `tls internal` when APP_DOMAIN is a LAN address or name that no public
	# authority can verify; Caddy then signs the certificate itself.
	{$APP_TLS}

	encode zstd gzip

	# Scheduled jobs are called by the scheduler container on the private
	# network, never from the internet.
	@cron path /api/cron/*
	respond @cron 404

	# Photos are shrunk in the browser and backups are downloads, so nothing
	# legitimate comes close to this.
	request_body {
		max_size 10MB
	}

	reverse_proxy app:3000 {
		# Overwrite, never append: whatever a client sends in these headers is
		# discarded. {client_ip} is the peer address unless trusted_proxies is set.
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
	}
}
