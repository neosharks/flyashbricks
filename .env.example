# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle: no secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Core ------------------------------------------------------------------
# Local docker compose default. Production: an authenticated, private-network URI.
MONGODB_URI=mongodb://localhost:27017/flyash?directConnection=true
MONGODB_DB_NAME=flyash

# openssl rand -base64 48
AUTH_SECRET=replace-me-with-at-least-32-random-characters-abcdef
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Fly Ash Bricks

# --- Redis (rate limiting) -------------------------------------------------
# Optional in development; REQUIRED in production (in-process limits do not
# hold across replicas or restarts).
REDIS_URL=redis://localhost:6379

# --- Email -----------------------------------------------------------------
# console | smtp. `console` writes the message to the log instead of sending.
MAIL_TRANSPORT=console
MAIL_FROM=alerts@example.com
# smtps://user:password@smtp.example.com:465
SMTP_URL=

# --- Scheduled jobs --------------------------------------------------------
# Shared secret for /api/cron/* so the endpoints cannot be triggered publicly.
CRON_SECRET=replace-me-with-a-long-random-string

# --- Observability ---------------------------------------------------------
# silent | fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Local docker ports ----------------------------------------------------
MONGO_PORT=27017
REDIS_PORT=6379

# --- Backups ---------------------------------------------------------------
# Scheduled backups run when POST /api/cron/backup is called with CRON_SECRET
# (see docker-compose.prod.yml). They are always encrypted with this
# passphrase; leave it empty to disable scheduled backups. Keep it in a
# password manager: without it a backup cannot be opened. 16+ characters.
BACKUP_PASSPHRASE=
# Where scheduled backups are written (a separate disk or mounted share is best).
BACKUP_DIR=
# Days a scheduled backup file is kept before it is pruned.
BACKUP_RETENTION_DAYS=30
# Comma-separated addresses that receive each scheduled backup by email.
BACKUP_EMAIL_TO=

# --- SMS and WhatsApp notifications ------------------------------------------
# none | console | webhook. `webhook` POSTs signed JSON to your gateway
# (MSG91, Gupshup, Twilio, …); see docs/notifications.md for the format.
SMS_PROVIDER=console
SMS_WEBHOOK_URL=
SMS_WEBHOOK_SECRET=
WHATSAPP_PROVIDER=console
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_SECRET=

# --- Uploaded files (employee photos) ----------------------------------------
# local: files on this server under STORAGE_DIR (a Docker volume in production).
# Moving to S3/R2 later means adding a driver in lib/storage — keys stay the same.
STORAGE_DRIVER=local
STORAGE_DIR=./storage
ASSET_MAX_UPLOAD_MB=8
ASSET_ORG_QUOTA_MB=2048

# --- Development on other devices -------------------------------------------
# Hostnames/IPs of this machine that phones on the same Wi-Fi use to reach
# `pnpm dev`, e.g. 192.168.1.71. Without it the page loads but nothing works.
DEV_ALLOWED_ORIGINS=
